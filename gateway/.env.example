# POSR auth gateway (server-only — never commit real secrets)
# LOCAL DEV ONLY — copy to gateway/.env. Must match root .env for compose.

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3142
# Same value as root .env GATEWAY_JWT_SECRET. Change for production.
GATEWAY_JWT_SECRET=13e14991c6724b218ce5e611684c28444f7ebc59c912b255bb69fbf692cac8deb379f1d01bcd48568d1ef437825873af
GATEWAY_JWT_TTL=12h
# Comma-separated frontend origins. Never "*" unless intentionally public.
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173

# --- Login brute-force throttle (all optional; defaults shown) ---
# Failed attempts for one client+login before a 15-min lock.
GATEWAY_LOGIN_MAX_FAILURES=5
# Failed attempts for one login from ANY IP before that login locks (PIN spray).
GATEWAY_LOGIN_LOGIN_MAX_FAILURES=10
# Failed attempts from one IP across ANY login before that IP locks.
GATEWAY_LOGIN_IP_MAX_FAILURES=30
# Lock duration, milliseconds.
GATEWAY_LOGIN_LOCK_MS=900000
# Rolling window in which failures are counted, milliseconds.
GATEWAY_LOGIN_WINDOW_MS=900000

# --- Surreal RPC relay allow-list ---
# enforce (default) — reject RPC methods / query DDL outside the allow-list
# log             — allow everything, log what would have been blocked
# off             — transparent relay (no inspection; pre-filter behaviour)
GATEWAY_RELAY_FILTER=enforce

SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NS=posr
SURREAL_DB=posr
# LOCAL DEV ONLY — must match SurrealDB and root .env.
SURREAL_USER=posr
SURREAL_PASS=posr-local-dev-change-me
SURREAL_CONNECT_TIMEOUT_MS=10000
